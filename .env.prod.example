# ============================================================
# .env.prod.example — plantilla para docker-compose.prod.yml
# ============================================================
# Copiar a .env.prod (ignorado por git) o cargar en Portainer
# (Stacks → Environment variables). TODOS los valores son de ejemplo:
# reemplazarlos antes de desplegar. Generar secretos con:
#   openssl rand -base64 48
#
# Dominios de ejemplo (proxy hosts en Nginx Proxy Manager):
#   tuevento.example.com      → frontend:80              (web + /api + /ws)
#   s3.tuevento.example.com   → rustfs:9000              (imágenes, URLs firmadas)
#   pay.tuevento.example.com  → fake-payment-gateway:4001 (popup de pago)
# ============================================================

# ─── Imágenes (Docker Hub) ────────────────────────────────────────────────────
TUEVENTO_IMAGE_REPO=jhampier23/tu-evento
TUEVENTO_VERSION=v1.0.0

# ─── PostgreSQL principal ─────────────────────────────────────────────────────
POSTGRES_DB=tuevento_db
POSTGRES_USER=tuevento
POSTGRES_PASSWORD=change-me-postgres-password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password

# ─── Almacenamiento S3 (RustFS) ───────────────────────────────────────────────
RUSTFS_ACCESS_KEY=change-me-rustfs-access-key
RUSTFS_SECRET_KEY=change-me-rustfs-secret-key-min-8-chars
# OBLIGATORIA. Host público con el que el backend firma las URLs de /storage/{id}/url.
# Si queda vacía, las URLs firmadas usan el host interno (http://rustfs:9000) y las
# imágenes no cargan en el navegador (el compose además se niega a arrancar sin ella).
# Debe coincidir exactamente con el proxy host de NPM (la firma incluye el Host).
RUSTFS_PUBLIC_URL=https://s3.tuevento.example.com

# ─── Notificaciones ───────────────────────────────────────────────────────────
# remote: las envía notification-service (Kafka). local: dentro del backend, sin el microservicio
# (vuelta atrás sin redesplegar imágenes).
NOTIFICATION_MODE=remote

# ─── Seguridad ────────────────────────────────────────────────────────────────
# Clave privada RS256 con la que el backend firma los JWT (PKCS#8). La pública se deriva
# de ella y se publica en /.well-known/jwks.json para los microservicios. Generarla así y
# pegarla en una sola línea, con los saltos escritos como \n:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   awk 'NF {printf "%s\\n", $0}' jwt-private.pem
# Cambiarla invalida las sesiones abiertas. No la subas al repositorio.
APP_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nchange-me\n-----END PRIVATE KEY-----
# HMAC-SHA256 anterior: solo valida tokens emitidos antes del cambio a RS256 (7 días).
# Pasado ese plazo se puede dejar vacío.
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
# Firma de los QR de tickets (distinto del JWT)
QR_SECRET=change-me-qr-secret-at-least-32-characters-long
# Vida del token QR en ms
QR_EXPIRATION=60000
# Orígenes del navegador permitidos (separados por coma, sin barra final)
APP_CORS_ALLOWED_ORIGINS=https://tuevento.example.com
# Swagger UI y /api-docs (no se publican por NPM aunque se activen)
SWAGGER_ENABLED=false
# Cookie httpOnly del refresh token de la web (tuevento_refresh, path /api/v1/auth).
# OPCIONALES: si se omiten, el compose usa Strict y true, que es lo correcto cuando la
# web y la API comparten dominio (aquí el frontend sirve /api con su nginx).
# - AUTH_COOKIE_SAME_SITE=Lax solo si un navegador no envía la cookie en el
#   POST /api/v1/auth/refresh tras volver del login social (la web vuelve a /login y el
#   refresh responde 401 REFRESH_TOKEN_REQUIRED). Lax sigue sin enviarla en POST desde
#   otros sitios. Basta con cambiar la variable y actualizar el stack: no hay que reconstruir.
# - NUNCA usar None: la enviaría también en peticiones desde otros sitios (CSRF).
# - AUTH_COOKIE_SECURE=false solo en local por http; en producción siempre true.
AUTH_COOKIE_SAME_SITE=Strict
AUTH_COOKIE_SECURE=true

# ─── OAuth ────────────────────────────────────────────────────────────────────
# URLs exactas a las que el backend puede redirigir tras el login social
APP_OAUTH_ALLOWED_FRONTEND_REDIRECT_URIS=https://tuevento.example.com/login
# URL COMPLETA del callback (no solo el dominio): el backend la usa tal cual como
# redirect_uri, tanto en el diálogo del proveedor como en el canje del code.
# Registrar exactamente este valor en Google Cloud Console (Authorized redirect URIs)
# y en Meta for Developers (Valid OAuth Redirect URIs).
APP_OAUTH_GOOGLE_REDIRECT_URI=https://tuevento.example.com/api/v1/auth/oauth/google/callback
APP_OAUTH_FACEBOOK_REDIRECT_URI=https://tuevento.example.com/api/v1/auth/oauth/facebook/callback
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me-google-client-secret
FACEBOOK_CLIENT_ID=000000000000000
FACEBOOK_CLIENT_SECRET=change-me-facebook-client-secret

# ─── Cuenta admin inicial ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@tuevento.example.com
ADMIN_PASSWORD=Change-Me-Admin-Password-123
ADMIN_ALIAS=AdminTuEvento
# storedFileId del avatar por defecto (lo crea ProfileDataInitializer al primer arranque)
APP_PROFILE_DEFAULT_AVATAR_ID=1

# ─── Correo (SMTP Gmail, contraseña de aplicación) ────────────────────────────
MAIL_USERNAME=notifications@example.com
MAIL_PASSWORD=change-me-app-password
NOTIFICATION_EMAIL_ENABLED=true

# ─── Moderación de imágenes ───────────────────────────────────────────────────
NSFW_THRESHOLD=0.6
# Opcional: si se dejan vacíos, se omite la verificación con Sightengine
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_MODELS=gore,nudity,weapon
SIGHTENGINE_THRESHOLD=0.6
SIGHTENGINE_NUDITY_THRESHOLD=0.15

# ─── Pagos (fake-payment-gateway) ─────────────────────────────────────────────
# Compartido entre backend y gateway para firmar los webhooks (HMAC-SHA256)
WEBHOOK_SECRET=change-me-webhook-secret
# API key de los endpoints /admin/** del gateway (cancelar y reembolsar pagos).
# ADMIN_API_KEY la exige el gateway (mínimo 16 caracteres; sin ella no arranca) y
# FAKE_GATEWAY_API_KEY es la que el backend envía en la cabecera X-Api-Key.
# Deben tener EXACTAMENTE el mismo valor. Generar con: openssl rand -hex 32
ADMIN_API_KEY=change-me-gateway-admin-api-key
FAKE_GATEWAY_API_KEY=change-me-gateway-admin-api-key
GATEWAY_POSTGRES_DB=fake_gateway_db
GATEWAY_POSTGRES_USER=fake_gateway
GATEWAY_POSTGRES_PASSWORD=change-me-gateway-postgres-password

# ─── Traducción (perfil "translate") ──────────────────────────────────────────
# Descomentar para levantar LibreTranslate (≈2 GB de RAM). Equivale a --profile translate
# y es la forma de activarlo desde Portainer.
# COMPOSE_PROFILES=translate
TRANSLATION_PROTECTED_TERMS=Tu Evento

# ─── JVM ──────────────────────────────────────────────────────────────────────
BACKEND_JAVA_OPTS=-Xms256m -Xmx768m -XX:MaxMetaspaceSize=256m
GATEWAY_JAVA_OPTS=-Xms64m -Xmx256m -XX:MaxMetaspaceSize=128m

# ─── Frontend (build args, NO se leen en runtime) ─────────────────────────────
# Vite los incrusta en el bundle al construir la imagen frontend-${TUEVENTO_VERSION}.
# Cambiarlos exige reconstruir la imagen (ver docs/deployment-vps.md).
VITE_API_URL=/api/v1
VITE_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
VITE_GATEWAY_URL=https://pay.tuevento.example.com

# Clave entre servicios para /internal/** (X-Internal-Api-Key). Vacía = /internal cerrado.
# Generar con: openssl rand -hex 32
INTERNAL_API_KEY=
