# Copia este archivo como .env y rellena los valores reales
EXPO_PUBLIC_API_URL=http://TU_IP:PUERTO/api/v1
EXPO_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
EXPO_PUBLIC_MINIO_HOST=tu_ip_local
EXPO_PUBLIC_GATEWAY_URL=http://TU_IP:4001

# Builds de EAS (perfil "preview" de eas.json): estas variables no se leen de este
# archivo, se configuran en el entorno "preview" de EAS, por ejemplo:
#   eas env:create --environment preview --name EXPO_PUBLIC_API_URL --value http://TU_IP:8090/api/v1 --visibility plaintext
#   eas env:create --environment preview --name EXPO_PUBLIC_MINIO_HOST --value TU_IP --visibility plaintext
#   eas env:create --environment preview --name EXPO_PUBLIC_GATEWAY_URL --value http://TU_IP:4001 --visibility plaintext
