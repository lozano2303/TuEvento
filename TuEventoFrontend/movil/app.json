{
  "expo": {
    "name": "Tu Evento",
    "slug": "movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "tuevento",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F054D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tuevento.movil",
      "infoPlist": {
        "NSCameraUsageDescription": "Se usa la cámara para escanear los códigos QR de las entradas."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F054D"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.tuevento.movil",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Se usa la cámara para escanear los códigos QR de las entradas."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "1763adb5-d019-4e06-9435-f9da43b462db"
      }
    }
  }
}
